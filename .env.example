# PostgreSQL (keep the password in DATABASE_URL in step with POSTGRES_PASSWORD)
POSTGRES_USER=pat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pat
DATABASE_URL=postgresql://pat:change-me@db:5432/pat

# Login and signed session cookie (use a long random value in production)
PAT_PIN=1234
SESSION_SECRET=replace-with-at-least-32-random-characters
PAT_TESTERS=Alex Morgan,Jamie Taylor

# Adam RMS. Use "mock" for local development or "adam" for the live API.
ADAM_PROVIDER=mock
ADAM_BASE_URL=https://your-adam-instance.example/api
ADAM_API_KEY=
ADAM_COMPANY_ID=lincoln-college

# Optional
APP_ORIGIN=http://localhost:3000
